# ------------------------------------------------------------------
# Backend environment (copy this file to `.env` at the repo root)
#   cp .env.example .env
# NEVER commit the real `.env` file — it is git-ignored.
# ------------------------------------------------------------------

# Application runtime: development | production | test
APP_ENV=development

# CORS origins allowed to call the API (comma separated, no wildcards)
# Same-origin Vite proxy does not need extra origins. Add them only when the
# browser calls the API on a different host.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite). Leave empty so `/api` is same-origin and proxied to :8000.
# VITE_API_BASE_URL=

# --- PostgreSQL connection -------------------------------------------------
# Option A (recommended): one full SQLAlchemy URL
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/astrology_db

# Option B: individual variables (used as a fallback when DATABASE_URL is empty)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astrology_db
